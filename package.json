{
  "name": "clone-tabnews",
  "version": "1.0.0",
  "description": "Projeto de clone do tabnews.com.br, feito no curso.dev do Filipe Deschamps",
  "main": "index.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "dev": "npm run docker:up && npm run docker:wait:database && npm run migration:up && next dev",
    "dev:next": "next dev",
    "teste": "npm run docker:up && concurrently --n next,jest --hide next -k --success command-jest \"next dev\" \"jest --runInBand --verbose \"",
    "teste:watch": "jest --runInBand --watchAll",
    "lint:prettier:check": "prettier --check .",
    "lint:prettier:fix": "prettier --write .",
    "lint:eslint:check": "eslint .",
    "docker:up": "docker compose -f infra/compose.yaml up -d",
    "docker:stop": "docker compose -f infra/compose.yaml stop",
    "docker:down": "docker compose -f infra/compose.yaml down",
    "docker:wait:database": "node infra/scripts/wait-for-postgres.js",
    "migration:create": "node-pg-migrate -m infra/migrations create",
    "migration:up": "node-pg-migrate -m infra/migrations --envPath .env.development up",
    "prepare": "husky",
    "commit": "cz"
  },
  "author": "",
  "license": "MIT",
  "dependencies": {
    "async-retry": "1.3.3",
    "dotenv-expand": "1000.0.0",
    "next": "16.3.0",
    "pg": "8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.1",
    "@commitlint/config-conventional": "21.2.0",
    "commitizen": "4.3.2",
    "concurrently": "10.0.4",
    "cz-conventional-changelog": "3.3.0",
    "dotenv": "17.4.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-jest": "29.16.0",
    "globals": "17.9.0",
    "husky": "9.1.7",
    "jest": "30.4.2",
    "node-pg-migrate": "9.0.0",
    "prettier": "3.9.6"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  }
}
